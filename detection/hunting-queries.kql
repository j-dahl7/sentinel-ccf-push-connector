// =============================================================================
// Feodotracker Botnet C2 Hunting Queries for Microsoft Sentinel
// Companion lab: nine-lives-security/nine-lives-zero-trust
// Data source: https://feodotracker.abuse.ch/
//
// These are proactive hunting queries — run manually during investigations,
// not as automated analytics rules.
// =============================================================================

// -----------------------------------------------------------------------------
// HUNT 1: Feed Indicators by Malware Label Over Time
// ATT&CK: No technique asserted from feed metadata alone.
// Purpose: Review how distinct feed IP counts vary by publisher-supplied label.
//   Changes can also reflect ingestion gaps, deduplication, or feed coverage.
// -----------------------------------------------------------------------------
FeodoTracker_CL
| where TimeGenerated > ago(30d)
| summarize C2Servers = dcount(ip_address)
    by malware, bin(TimeGenerated, 1d)
| render timechart

// -----------------------------------------------------------------------------
// HUNT 2: Online Feed Indicators by Country (Last 30 Days)
// ATT&CK: Geography alone does not establish T1583.
// Purpose: Review country metadata associated with online feed rows. Do not use
//   this aggregation alone for attribution or geographic blocking.
// -----------------------------------------------------------------------------
FeodoTracker_CL
| where TimeGenerated > ago(30d)
| where status == "online"
| summarize
    ActiveC2 = dcount(ip_address),
    Families = make_set(malware, 20)
    by country
| sort by ActiveC2 desc
| take 20

// -----------------------------------------------------------------------------
// HUNT 3: Feed IPs First Seen in Last 7 Days
// ATT&CK: No technique asserted from first-seen time alone.
// Purpose: Surface recently first-seen feed rows for contextual review. Freshness
//   does not establish severity or suitability for blocking.
// -----------------------------------------------------------------------------
FeodoTracker_CL
| where TimeGenerated > ago(7d)
| where first_seen > ago(7d)
| summarize arg_max(TimeGenerated, *) by ip_address
| project
    ip_address,
    port,
    malware,
    country,
    first_seen,
    last_seen,
    status
| sort by first_seen desc

// -----------------------------------------------------------------------------
// HUNT 4: Long-Lived Online Feed Indicators (> 90 Days)
// ATT&CK: No technique asserted from observation duration alone.
// Purpose: Surface long-observed feed rows for review. Duration does not prove
//   bulletproof hosting, failed takedown, current malice, or actor capability.
// -----------------------------------------------------------------------------
FeodoTracker_CL
| where TimeGenerated > ago(1d)
| where status == "online"
| extend DaysActive = datetime_diff('day', now(), first_seen)
| where DaysActive > 90
| summarize arg_max(TimeGenerated, *) by ip_address
| project
    ip_address,
    port,
    malware,
    country,
    first_seen,
    DaysActive
| sort by DaysActive desc

// -----------------------------------------------------------------------------
// HUNT 5: Feed Ingestion Health Check
// Purpose: Audit the freshness and completeness of the Feodotracker feed.
//   Identify gaps in ingestion (missed cron runs, expired secrets, rate limits)
//   and track how the feed composition changes over time.
// -----------------------------------------------------------------------------
FeodoTracker_CL
| summarize
    RecordCount = count(),
    DistinctIPs = dcount(ip_address),
    Families = dcount(malware),
    Countries = dcount(country),
    OnlineCount = countif(status == "online"),
    OldestRecord = min(first_seen),
    NewestRecord = max(last_seen)
    by bin(TimeGenerated, 6h)
| extend OnlinePercent = round(100.0 * OnlineCount / RecordCount, 1)
| sort by TimeGenerated desc
